NODE_ENV=development
PORT=3000

# Database (Option A: Connection URI - typical for Cloud MySQL e.g. Aiven, Clever Cloud)
# DATABASE_URL=mysql://user:password@host:port/database_name

# Database (Option B: Individual parameters - typical for cPanel)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=the_kitchen_malta
DB_PORT=3306

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Upload Paths
FRONTEND_URL=http://localhost:5173
UPLOAD_BASE_URL=http://localhost:3000/uploads

# Google OAuth (for social auth)
GOOGLE_CLIENT_ID=

# Stripe (future)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (future)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
